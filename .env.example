# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).

# ── Auth: choose ONE path ──────────────────────────────────────────────
# (a) Gemini Developer API — simplest for local dev:
GEMINI_API_KEY=

# (b) Vertex AI — uses Application Default Credentials (gcloud auth / Workload Identity).
#     Leave GEMINI_API_KEY blank and set these instead:
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1

# ── Models ─────────────────────────────────────────────────────────────
# Defaults target the Gemini 2.5 family (GA). Confirm the EXACT identifiers in the
# Google Cloud / AI Studio console the day you run this and override here if needed.
MODEL_WRITER=gemini-2.5-pro          # article quality (reasoning, coherence)
MODEL_PARSER=gemini-2.5-flash        # multimodal PDF → brief
MODEL_CHEAP=gemini-2.5-flash         # verify / repair / extract (cheap, fast)

# ── Generation knobs (optional) ────────────────────────────────────────
WRITER_TEMPERATURE=0.5
MAX_OUTPUT_TOKENS=2048
MAX_REPAIR_ITERS=3
LLM_MAX_RETRIES=3
REQUEST_TIMEOUT_S=60

# ── Misc (optional) ────────────────────────────────────────────────────
# DATA_DIR=./data
# PROMPT_VERSION=p1
