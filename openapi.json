  "components": {
    "schemas": {
      "BlockSpecModel": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "$ref": "#/components/schemas/BlockType"
          },
          "min_words": {
            "type": "integer",
