            "default": false
          },
          "theme_color": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme Color"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "min_words",
          "max_words"
        ],
        "title": "BlockSpecModel"
      },
      "BlockType": {
        "type": "string",
        "enum": [
          "heading",
          "subheading",
          "body",
          "caption",
          "cta"
        ],
        "title": "BlockType"
      },
      "Body_upload_documents_companies__pair_id__documents_post": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "sender",
              "receiver"
            ],
            "title": "Role"
          },
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "role",
          "files"
        ],
        "title": "Body_upload_documents_companies__pair_id__documents_post"
      },
      "BriefsResponse": {
        "properties": {
          "pair_id": {
            "type": "string",
            "title": "Pair Id"
          },
          "sender": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompanyBrief"
              },
              {
                "type": "null"
              }
            ]
          },
          "receiver": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompanyBrief"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "pair_id"
        ],
        "title": "BriefsResponse"
      },
      "CompanyBrief": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "sender",
              "receiver"
            ],
            "title": "Role"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "industry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Industry"
          },
          "offerings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Offerings"
          },
          "value_props": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Value Props"
          },
          "pain_points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pain Points"
          },
          "tone_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tone Signals"
          },
          "key_stats": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Key Stats"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "type": "array",
            "title": "Facts"
          },
          "logo_asset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logo Asset"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageAsset"
            },
            "type": "array",
            "title": "Images"
          }
        },
        "type": "object",
        "required": [
          "role",
          "name"
        ],
        "title": "CompanyBrief",
        "description": "The distilled, reusable, source-tagged representation of one company."
      },
      "Fact": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "stable id, e.g. 'recv.pain.2' \u2014 referenced by article citations"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "kind": {
